# desktop/zeropi-push.service -- the resident systemd --user service that
# owns cadence for the Desktop role (spec §7.5, ticket #47): a 30s snapshot
# poll, throttled/coalesced Gauge pushes, and a 04:00-local Batch (plus a
# startup catch-up if the last one is >24h stale). The decision logic lives
# in desktop/service.py; this unit just keeps that loop running.
#
# MUST run as a systemd --user service, never system-level as a different
# user: the rate-limit snapshot it polls is 0600 under ~/.local/state,
# readable only by the owning user.
#
# A template: install-desktop.sh rewrites ExecStart and WorkingDirectory for
# the layout it detected (docs/spec-web-ui.md §9.2) and writes it to
# ~/.config/systemd/user/, but never enables it -- the web UI's Setup tab
# does, after a successful pair (§9.4). The defaults below are the
# standalone layout. Logs: journalctl --user -u zeropi-push -f

[Unit]
Description=zeropi.display Desktop push service (Gauge poll + Batch loop)
Documentation=https://github.com/peterderkoala/zeropi.display/blob/dev/docs/spec-usage-pipeline.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# service.py logs only exceptions itself; everything informative on a normal
# run ("Batch complete: N sent", "Gauge push ok") is a print() in push.py.
# Under systemd stdout is a journal socket rather than a tty, so Python
# block-buffers it and `journalctl --user -u zeropi-push -f` (what the header
# above tells you to run) shows nothing at all. Found while verifying #48.
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/.local/share/zeropi-display
ExecStart=%h/.local/share/zeropi-display/venv/bin/python3 %h/.local/share/zeropi-display/service.py
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
